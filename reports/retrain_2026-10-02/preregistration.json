            "--canonical",
            "data/external/vsl_gh/dataset_canonical.json",
            "--out",
            "data/external/vsl_gh/gloss_vocab_canonical.txt",
            "--sentence-split",
            "configs/vslgh_sentence_split_v1.json",
            "--split",
            "train"
