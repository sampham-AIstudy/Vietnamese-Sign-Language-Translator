  "jobs": {
    "seed": 42,
    "k1": {
      "kernel": "phmvnsm33/vsl-retrain-stgcn-tier1",
      "dir": "kaggle/vsl-retrain-stgcn-tier1",
      "train": {
        "argv": [
          "train.py",
          "--config",
          "configs/experiments/stgcn.yaml",
