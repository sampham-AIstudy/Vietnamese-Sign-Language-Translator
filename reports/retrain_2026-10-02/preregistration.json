      "modes": {
        "preflight": "CPU, no accelerator: rebuild the data, measure with scripts/retrain_preregister.py (measure_*), compare with this file, stop on any difference; no training, no test",
        "train": "preflight again, then backbone sha256 == k1_outputs.json, LEAK CHECK, GPU0 CSLR | GPU1 ViT5 s1 -> s2"
      },
      "data_prep": {
        "vsl_gh": {
          "argv": [
            "scripts/prepare_canonical_vsl_gh.py"
          ],
