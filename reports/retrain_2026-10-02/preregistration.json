          "checkpoints/stgcn_best.pt",
          "--output-dir",
          "/kaggle/working/k1/eval"
        ],
        "command": "python evaluate_test.py --config configs/experiments/stgcn.yaml --checkpoint checkpoints/stgcn_best.pt --output-dir /kaggle/working/k1/eval"
      },
      "history_file": "experiments/stgcn/history.json",
      "checkpoint": "checkpoints/stgcn_best.pt",
      "selection": {
        "split": "val (tier1_grouped_val.csv)",
        "rule": "max val top-1, tie -> lower val loss",
        "rule_ref": "src/training/trainer.py:198"
      },
      "test_policy": "Tier 1 test (tier1_grouped_test.csv) evaluated exactly once by evaluate_test.py, after the sanity checks pass",
      "sanity": [
